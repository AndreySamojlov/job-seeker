+++ b/tests/submit/test_package_integrity.py
@@ -0,0 +1,53 @@
+from types import SimpleNamespace
+
+import pytest
+
+from job_machine.submit import service
+from tests.package.test_integrity import bound_manifest
+
+
+@pytest.mark.parametrize('agent_sid', [None, 'retained-session'])
+@pytest.mark.parametrize('change', ['answer','consent','identity','resume'])
+def test_tampered_package_stops_before_browser_or_click(monkeypatch, agent_sid, change):
+    manifest = bound_manifest()
+    row = {'application_id':'app1','payload_hash':manifest.payload_hash,
+           'resume':{'path':'/synthetic/resume.pdf','content_hash':'resumehash'},
+           'manifest_path':'/synthetic/manifest.json','agent_fill_session_id':agent_sid}
+    if change == 'answer': manifest.answers[0].value = 'changed@example.test'
+    if change == 'consent': manifest.consents[0].decision = 'accept'
+    if change == 'identity': manifest.application_id = 'another-app'
+    if change == 'resume': manifest.resume.content_hash = 'another-resume'
+    blocks = []
+    monkeypatch.setattr(service, '_load_manifest', lambda path: manifest)
+    monkeypatch.setattr(service, 'hash_file', lambda path:'resumehash')
+    monkeypatch.setattr(service.gate, 'check_submit_gate', lambda *a:None)
+    monkeypatch.setattr(service, '_block_claim', lambda c,r,s,b,d:blocks.append(b))
+    def forbidden(*a,**kw):
+        pytest.fail('Unverified package reached browser or click boundary')
+    monkeypatch.setattr(service.store, 'mark_clicking', forbidden)
+    browser = SimpleNamespace(create_session=forbidden, inspect=forbidden,
+        inspect_current=forbidden, submit=forbidden, dispose=lambda *a:None, release=lambda *a:None)
+    service._submit_claim(None, browser, row, None)
+    assert blocks == ['manifest_integrity_mismatch']
+
+
+@pytest.mark.parametrize('agent_sid', [None, 'retained-session'])
+def test_resume_changed_during_inspection_is_rechecked_before_click(monkeypatch, agent_sid):
+    from job_machine.browser.schema import FormSchema, InspectResult
+    manifest = bound_manifest()
+    row = {'application_id':'app1','attempt_id':'attempt1','payload_hash':manifest.payload_hash,
+           'resume':{'path':'/synthetic/resume.pdf','content_hash':'resumehash'},
+           'manifest_path':'/synthetic/manifest.json','agent_fill_session_id':agent_sid}
+    monkeypatch.setattr(service, '_load_manifest', lambda path:manifest)
+    monkeypatch.setattr(service.gate, 'check_submit_gate', lambda *a:None)
+    hashes = iter(['resumehash','changed-during-inspect'])
+    monkeypatch.setattr(service, 'hash_file', lambda path:next(hashes))
+    blocks = []
+    monkeypatch.setattr(service, '_block_claim', lambda c,r,s,b,d:blocks.append(b))
+    def forbidden(*a,**kw): pytest.fail('Changed resume reached click boundary')
+    monkeypatch.setattr(service.store, 'mark_clicking', forbidden)
+    def inspect(*a): return InspectResult(form_schema=FormSchema(url=manifest.destination_url))
+    browser = SimpleNamespace(create_session=lambda:'new',inspect=inspect,inspect_current=inspect,
+                              dispose=lambda *a:None,release=lambda *a:None)
+    service._submit_claim(None,browser,row,None)
+    assert blocks == ['NoResumeUploadWithoutHashMatch']
