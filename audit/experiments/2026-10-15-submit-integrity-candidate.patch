diff --git a/src/job_machine/package/integrity.py b/src/job_machine/package/integrity.py
new file mode 100644
--- /dev/null
+++ b/src/job_machine/package/integrity.py
@@ -0,0 +1,24 @@
+"""Verify the canonical package contract from actual members, without I/O.
+
+This binds a package to an application and resume hash. It does not inspect a
+browser page, establish approval, or prove that an attached file is the resume.
+"""
+from job_machine.package import hashing
+
+
+def validate_manifest_binding(manifest, *, application_id: str,
+                              payload_hash: str, resume_hash: str) -> bool:
+    if not application_id or not payload_hash or not resume_hash:
+        return False
+    try:
+        return (
+            manifest.application_id == str(application_id)
+            and manifest.resume.content_hash == resume_hash
+            and manifest.answers_hash == hashing.answers_hash(manifest.answers)
+            and manifest.consents_hash == hashing.consents_hash(manifest.consents)
+            and manifest.payload_hash == payload_hash
+            and hashing.payload_hash(manifest.destination_url, resume_hash,
+                                     manifest.answers, manifest.consents) == payload_hash
+        )
+    except (AttributeError, TypeError, ValueError):
+        return False
