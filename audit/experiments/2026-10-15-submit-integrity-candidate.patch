@@ -0,0 +1,38 @@
+import pytest
+
+from job_machine.package.builder import build_package
+from job_machine.package.models import AnswerRecord, PackageInput, ResumeArtifact
+
+
+def bound_manifest():
+    return build_package(
+        PackageInput(application_id='app1', company='Synthetic', role='Tester',
+                     destination_url='https://example.test/jobs/1'),
+        [AnswerRecord(field='Email', value='synthetic@example.test', state='locked'),
+         AnswerRecord(field='Privacy', value='decline', state='optional-policy')],
+        ResumeArtifact(filename='resume.pdf', path='/synthetic/resume.pdf', content_hash='resumehash'))
+
+
+@pytest.mark.parametrize('change', ['none','answer','consent','destination','identity',
+                                   'resume','answers_hash','consents_hash','payload_hash'])
+def test_binding_uses_actual_values_not_declared_hash(change):
+    from job_machine.package.integrity import validate_manifest_binding
+    manifest = bound_manifest()
+    approved_hash = manifest.payload_hash
+    if change == 'answer': manifest.answers[0].value = 'changed@example.test'
+    if change == 'consent': manifest.consents[0].decision = 'accept'
+    if change == 'destination': manifest.destination_url = 'https://example.test/jobs/2'
+    if change == 'identity': manifest.application_id = 'different-app'
+    if change == 'resume': manifest.resume.content_hash = 'different-resume'
+    if change == 'answers_hash': manifest.answers_hash = 'forged'
+    if change == 'consents_hash': manifest.consents_hash = 'forged'
+    if change == 'payload_hash': manifest.payload_hash = 'forged'
+    result = validate_manifest_binding(manifest, application_id='app1',
+                                      payload_hash=approved_hash, resume_hash='resumehash')
+    assert result is (change == 'none')
+
+
+@pytest.mark.parametrize('manifest', [None, object(), {'payload_hash':'forged'}])
+def test_incomplete_binding_fails_closed(manifest):
+    from job_machine.package.integrity import validate_manifest_binding
+    assert validate_manifest_binding(manifest, application_id='app1', payload_hash='ph', resume_hash='rh') is False
